# ─────────────────────────────────────────────────────────────
# ShifuBot configuration. Copy this file to .env and fill it in.
# Every value marked REQUIRED must be set or the bot will not start.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Bot token from Discord Developer Portal > your app > Bot > Reset Token.
# Never share it and never commit it.
DISCORD_TOKEN=

# REQUIRED. Application ID from Developer Portal > General Information.
DISCORD_CLIENT_ID=

# REQUIRED. OAuth2 client secret from Developer Portal > OAuth2 > Client Secret.
DISCORD_CLIENT_SECRET=

# REQUIRED. The public address people use to open the dashboard, without a trailing slash.
# The OAuth redirect URL you add in the Developer Portal is PUBLIC_URL + /auth/callback
# Examples: http://localhost:3000  or  https://shifu.example.com
PUBLIC_URL=http://localhost:3000

# REQUIRED. Random secret used to sign session cookies. At least 32 characters.
# Generate one with:  bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Port of the web server. Pelican sets SERVER_PORT automatically; PORT is the fallback.
# PORT=3000
# SERVER_PORT=

# Interface to bind to. Keep 0.0.0.0 for Docker and Pelican.
# HOST=0.0.0.0

# Where the SQLite database lives. Relative paths start at the working directory.
# DATABASE_PATH=./data/shifubot.db

# Logging: trace, debug, info, warn, error. Output is JSON in production.
# LOG_LEVEL=info

# Language for new servers: en or hu. Each server can change it in the dashboard.
# DEFAULT_LOCALE=en

# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy (nginx, Caddy, Pelican proxy).
# Set to false when the server is exposed directly to the internet.
# TRUST_PROXY=true

# Max welcome messages per server per minute. Protects channels during raids.
# WELCOME_MAX_PER_MINUTE=10

# How many Discord messages the bot sends in parallel across all servers.
# SEND_CONCURRENCY=4

# Days to keep data for servers that removed the bot before it is deleted.
# CLEANUP_AFTER_DAYS=30

# Run only the dashboard and API without logging the bot in. Useful for UI work.
# BOT_DISABLED=false
